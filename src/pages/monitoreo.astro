---
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
import BeachStatusCard from "../components/monitoring/BeachStatusCard.astro";
import MonitoringLogTable from "../components/monitoring/MonitoringLogTable.astro";
import MonitoringForm from "../components/monitoring/MonitoringForm.astro";

import { beachesData, monitoringLogsData } from "../data/beachMonitoring";
---

<Layout
  title="Monitoreo de Playas en Tiempo Real | COCOMANORTE"
  description="Sistema de registro y monitoreo en tiempo real de playas de anidación de tortugas marinas del Consejo Comunitario Mayor COCOMANORTE."
>
  <!-- Encabezado del Sistema de Monitoreo -->
  <Section>
    <div class="header-content">
      <span class="badge">Sistema Comunitario de Datos</span>
      <h1>Monitoreo de Playas en Tiempo Real</h1>
      <p class="lead">
        Plataforma oficial de COCOMANORTE para el seguimiento, registro de nidos, eclosiones y vigilancia comunitaria de las playas de anidación en el territorio colectivo.
      </p>

      <!-- Resumen Global de Datos -->
      <div class="summary-cards">
        <div class="summary-box">
          <span class="summary-num">295</span>
          <span class="summary-label">Total Nidos Activos</span>
        </div>
        <div class="summary-box">
          <span class="summary-num">7,400+</span>
          <span class="summary-label">Neonatos Liberados (2025)</span>
        </div>
        <div class="summary-box">
          <span class="summary-num">3 Playas</span>
          <span class="summary-label">Sectores bajo Monitoreo</span>
        </div>
      </div>
    </div>
  </Section>

  <!-- Estado de las Playas en Tiempo Real -->
  <Section>
    <h2>Estado Actual de las Playas de Anidación</h2>
    <p class="section-desc">
      Reporte de actividad, nivel de amenaza y conteo de nidos actualizados por los comités de guardia comunitarios.
    </p>

    <div class="beaches-grid">
      {beachesData.map((beach) => (
        <BeachStatusCard beach={beach} />
      ))}
    </div>
  </Section>

  <!-- Tabla de Registros Recientes -->
  <Section>
    <h2>Últimos Registros de Patrullaje y Anidación</h2>
    <p class="section-desc">
      Bitácora en tiempo real de eventos reportados en las playas del territorio.
    </p>

    <MonitoringLogTable logs={monitoringLogsData} />
  </Section>

  <!-- Formulario de Registro para Patrulleros -->
  <Section>
    <MonitoringForm />
  </Section>
</Layout>

<style>
  .header-content {
    max-width: 850px;
  }

  .badge {
    display: inline-block;
    background: var(--verde-claro, #dcfce7);
    color: var(--verde-territorio, #166534);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    color: var(--verde-territorio, #166534);
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .lead {
    font-size: 1.2rem;
    line-height: 1.6;
    color: #374151;
    margin-bottom: 2rem;
  }

  .summary-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .summary-box {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .summary-num {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--verde-territorio, #166534);
  }

  .summary-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #374151;
    margin-top: 0.25rem;
  }

  h2 {
    font-size: 1.8rem;
    color: var(--verde-territorio, #166534);
    margin-bottom: 0.5rem;
  }

  .section-desc {
    font-size: 1.05rem;
    color: #4b5563;
    margin-bottom: 2rem;
  }

  .beaches-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }
</style>
