---
import Container from "../layout/Container.astro";

interface Props {
  title?: string;

  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="section">
  <Container>
    {title && <h2>{title}</h2>}

    {subtitle && <p class="subtitle">{subtitle}</p>}

    <div class="content">
      <slot />
    </div>
  </Container>
</section>

<style>
  .section {
    padding: 80px 0;
  }

  h2 {
    text-align: center;

    color: var(--verde-territorio);

    font-size: 2.2rem;
  }

  .subtitle {
    text-align: center;
  }
</style>
