---
/**
 * ------------------------------------------------------------------
 * COMPONENTE
 * ------------------------------------------------------------------
 *
 * Nombre:
 *      Button
 *
 * Descripción:
 *      Botón reutilizable para acciones y navegación.
 *
 * Responsabilidades:
 *
 *      - Mantener el diseño consistente de botones.
 *      - Evitar repetir estilos.
 *      - Permitir diferentes variantes.
 *      - Respetar la propiedad `base` de Astro mediante `getRelativeUrl`.
 *
 * Uso:
 *
 * <Button href="/contacto">
 *      Contacto
 * </Button>
 *
 * Proyecto:
 *      COCOMANORTE Web
 *
 * ------------------------------------------------------------------
 */
import { getRelativeUrl } from "../../utils/url";

interface Props {
  href: string;
  variant?: "primary" | "secondary" | "outline";
}

const { href, variant = "primary" } = Astro.props;
const formattedHref = getRelativeUrl(href);
---

<a href={formattedHref} class={`button ${variant}`}>
  <slot />
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 24px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  .button:focus-visible {
    outline: 2px solid var(--verde-territorio, #166534);
    outline-offset: 2px;
  }

  .primary {
    background: var(--verde-territorio, #166534);
    color: white;
    border: 1px solid var(--verde-territorio, #166534);
  }

  .primary:hover {
    background: #14532d;
    border-color: #14532d;
  }

  .secondary {
    background: transparent;
    color: var(--verde-territorio, #166534);
    border: 2px solid var(--verde-territorio, #166534);
  }

  .secondary:hover {
    background: var(--verde-territorio, #166534);
    color: white;
  }

  .outline {
    background: #ffffff;
    color: var(--verde-territorio, #166534);
    border: 1px solid #d1d5db;
  }

  .outline:hover {
    background: var(--verde-claro, #dcfce7);
    border-color: var(--verde-territorio, #166534);
    color: var(--verde-territorio, #166534);
  }
</style>
