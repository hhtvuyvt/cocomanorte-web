---
import Container from "./Container.astro";
import { navigation } from "../../data/navigation";
import { site } from "../../data/site";
import { getRelativeUrl } from "../../utils/url";
---

<header class="header">
  <Container>
    <a href={getRelativeUrl("/")} class="logo">
      <div class="logo-icon">
        <img src={getRelativeUrl("/logo/logo.jpg")} alt={site.title} class="logo-image" />
      </div>

      <div class="logo-text">
        <span class="nombre"> {site.title} </span>

        <span class="eslogan"> {site.slogan} </span>
      </div>
    </a>

    <!-- Botón Menú Hamburguesa Móvil -->
    <button
      id="menu-toggle"
      class="mobile-toggle"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <nav id="nav-menu" class="nav-container">
      <ul class="menu">
        {
          navigation.map((item) => (
            <li>
              <a href={getRelativeUrl(item.href)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>
</header>

<script>
  const toggleBtn = document.getElementById("menu-toggle");
  const navMenu = document.getElementById("nav-menu");

  if (toggleBtn && navMenu) {
    toggleBtn.addEventListener("click", () => {
      const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
      toggleBtn.setAttribute("aria-expanded", (!isExpanded).toString());
      toggleBtn.classList.toggle("active");
      navMenu.classList.toggle("active");
    });
  }
</script>
