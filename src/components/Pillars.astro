---
import Section from "./ui/Section.astro";
---

<Section
  title="Nuestros principios"
  subtitle="Los fundamentos que orientan nuestro trabajo comunitario"
>
  <h2>Nuestros pilares</h2>

  <div class="container">
    <div class="card">
      <h3>Territorio</h3>

      <p>Protección y fortalecimiento del territorio colectivo.</p>
    </div>

    <div class="card">
      <h3>Cultura</h3>

      <p>Saberes ancestrales, memoria e identidad comunitaria.</p>
    </div>

    <div class="card">
      <h3>Conservación</h3>

      <p>Protección de ecosistemas y biodiversidad.</p>
    </div>

    <div class="card">
      <h3>Turismo comunitario</h3>

      <p>Experiencias desde nuestra cultura y territorio.</p>
    </div>
  </div>
</Section>

<style>
  .container {
    display: grid;

    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));

    gap: 20px;
  }

  .card {
    padding: 25px;

    background: #f3f4f6;

    border-radius: 12px;
  }
</style>
