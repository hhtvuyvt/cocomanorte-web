    <nav>
      <ul class="menu">
        <li>
          <a href="/">Inicio</a>
        </li>

        <li>
          <a href="/quienes-somos"> Organización </a>
        </li>

        <li>
          <a href="/territorio"> Territorio </a>
        </li>

        <li>
          <a href="/turismo"> Turismo </a>
        </li>

        <li>
          <a href="/contacto"> Contacto </a>
        </li>
      </ul>
    </nav>
