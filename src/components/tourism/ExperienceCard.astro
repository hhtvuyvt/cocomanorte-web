---
import type { Experience } from "../../data/tourism";

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;
---

<div class="experience-card">
  <div class="card-header">
    <div class="tags">
      <span class="category-badge">{experience.category}</span>
      {experience.recommendedSeason && (
        <span class="season-badge">📅 {experience.recommendedSeason}</span>
      )}
    </div>
    <h3 class="title">{experience.title}</h3>
  </div>

  <div class="meta-row">
    <span class="meta-item">⏱️ {experience.duration}</span>
    <span class="meta-item">📍 {experience.location}</span>
  </div>

  <p class="description">{experience.description}</p>

  <div class="highlights-section">
    <span class="highlights-title">Incluye / Destacados:</span>
    <ul class="highlights-list">
      {experience.highlights.map((item) => (
        <li>✨ {item}</li>
      ))}
    </ul>
  </div>
</div>

<style>
  .experience-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .experience-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .category-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--verde-claro, #dcfce7);
    color: var(--verde-territorio, #166534);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .season-badge {
    font-size: 0.75rem;
    font-weight: 600;
    background: #fef3c7;
    color: #92400e;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: #111827;
  }

  .meta-row {
    display: flex;
    gap: 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #4b5563;
    flex-wrap: wrap;
  }

  .description {
    font-size: 0.95rem;
    color: #374151;
    line-height: 1.5;
    margin: 0;
  }

  .highlights-section {
    margin-top: auto;
    background: #f9fafb;
    padding: 0.85rem;
    border-radius: 8px;
  }

  .highlights-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: #4b5563;
    display: block;
    margin-bottom: 0.35rem;
  }

  .highlights-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .highlights-list li {
    font-size: 0.85rem;
    color: #4b5563;
  }
</style>
