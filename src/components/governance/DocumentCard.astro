---
import type { OfficialDocument } from "../../data/documents";

interface Props {
  document: OfficialDocument;
}

const { document } = Astro.props;
---

<div class="document-card">
  <div class="doc-icon">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="icon">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
    </svg>
  </div>

  <div class="doc-body">
    <div class="meta">
      <span class="category">{document.category}</span>
      <span class="date">{document.date}</span>
    </div>
    <h3 class="title">{document.title}</h3>
    <p class="description">{document.description}</p>

    <div class="actions">
      <a href={document.fileUrl || "#"} class="download-button" aria-label={`Descargar ${document.title}`}>
        <span>Descargar Documento</span>
        {document.fileSize && <span class="file-size">({document.fileSize})</span>}
      </a>
    </div>
  </div>
</div>

<style>
  .document-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    gap: 1.25rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
    align-items: flex-start;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .document-card:hover {
    border-color: var(--verde-territorio, #166534);
    box-shadow: 0 8px 12px -2px rgba(0, 0, 0, 0.08);
  }

  .doc-icon {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: var(--verde-claro, #dcfce7);
    color: var(--verde-territorio, #166534);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon {
    width: 26px;
    height: 26px;
  }

  .doc-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.35rem;
  }

  .category {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--azul-caribe, #0369a1);
    background: #e0f2fe;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .date {
    font-size: 0.8rem;
    color: #6b7280;
  }

  .title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0.25rem 0 0.5rem;
    color: #1f2937;
  }

  .description {
    font-size: 0.9rem;
    color: #4b5563;
    line-height: 1.4;
    margin: 0 0 1rem;
  }

  .actions {
    margin-top: auto;
  }

  .download-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--verde-territorio, #166534);
    text-decoration: none;
    background: #f0fdf4;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    border: 1px solid #bbf7d0;
    transition: background 0.2s ease;
  }

  .download-button:hover {
    background: #dcfce7;
  }

  .file-size {
    font-weight: 400;
    font-size: 0.8rem;
    color: #4b5563;
  }
</style>
