---
import type { BeachForecast } from "../../data/beachMonitoring";

interface Props {
  forecasts: BeachForecast[];
}

const { forecasts } = Astro.props;
---

<div class="forecast-container">
  <div class="forecast-header">
    <div class="header-text">
      <span class="badge-meteorology">🌤️ Previsión Metereológica & Mareas</span>
      <h2>Pronóstico de Seguridad y Viabilidad para Patrullaje</h2>
      <p class="intro">
        Consulta el estado del tiempo, la tabla de mareas y la viabilidad de acceso a las playas antes de iniciar la jornada de monitoreo.
      </p>
    </div>
  </div>

  <div class="forecast-grid">
    {
      forecasts.map((f) => (
        <div class="forecast-card">
          <div class="card-top">
            <div class="beach-info">
              <h3 class="beach-title">{f.beachName}</h3>
              <span class="forecast-date">{f.date}</span>
            </div>

            <div class={`status-badge ${f.feasibilityStatus.includes("Favorables") ? "favorable" : "warning"}`}>
              {f.feasibilityStatus.includes("Favorables") ? "🟢" : "🟡"} {f.feasibilityStatus}
            </div>
          </div>

          <p class="reason-text">{f.feasibilityReason}</p>

          <!-- Métricas del clima -->
          <div class="weather-metrics">
            <div class="metric">
              <span class="metric-icon">🌡️</span>
              <div class="metric-data">
                <span class="metric-value">{f.temperatureCelsius}°C</span>
                <span class="metric-label">Temp. Ambiente</span>
              </div>
            </div>

            <div class="metric">
              <span class="metric-icon">🌧️</span>
              <div class="metric-data">
                <span class="metric-value">{f.rainProbabilityPercent}%</span>
                <span class="metric-label">Lluvia</span>
              </div>
            </div>

            <div class="metric">
              <span class="metric-icon">💨</span>
              <div class="metric-data">
                <span class="metric-value">{f.windSpeedKmH} km/h</span>
                <span class="metric-label">Viento ({f.windDirection})</span>
              </div>
            </div>

            <div class="metric">
              <span class="metric-icon">🌊</span>
              <div class="metric-data">
                <span class="metric-value">{f.waveHeightMeters}m</span>
                <span class="metric-label">Oleaje</span>
              </div>
            </div>
          </div>

          <!-- Previsión de Mareas -->
          <div class="tides-box">
            <span class="tides-heading">🌊 Tabla de Mareas Estimada:</span>
            <div class="tides-list">
              {f.tides.map((t) => (
                <div class="tide-item">
                  <span class="tide-time">{t.time}</span>
                  <span class="tide-type">{t.type} ({t.heightMeters}m)</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Recomendación para el Monitor -->
          <div class="recommendation-box">
            <strong>💡 Recomendación Guardia / Monitor:</strong>
            <p>{f.recommendationForPatrollers}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .forecast-container {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
    margin-bottom: 2.5rem;
  }

  .badge-meteorology {
    display: inline-block;
    background: #e0f2fe;
    color: var(--azul-caribe, #0369a1);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  h2 {
    font-size: 1.8rem;
    color: var(--verde-territorio, #166534);
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  .intro {
    font-size: 1rem;
    color: #4b5563;
    line-height: 1.5;
    margin-bottom: 1.75rem;
  }

  .forecast-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .forecast-card {
    background: #fafafa;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .beach-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: #111827;
    margin: 0;
  }

  .forecast-date {
    font-size: 0.8rem;
    color: #6b7280;
  }

  .status-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .status-badge.favorable {
    background: #dcfce7;
    color: #166534;
  }

  .status-badge.warning {
    background: #fef3c7;
    color: #92400e;
  }

  .reason-text {
    font-size: 0.9rem;
    color: #374151;
    margin: 0;
    line-height: 1.4;
  }

  .weather-metrics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 0.85rem;
  }

  .metric {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .metric-icon {
    font-size: 1.25rem;
  }

  .metric-data {
    display: flex;
    flex-direction: column;
  }

  .metric-value {
    font-size: 0.95rem;
    font-weight: 700;
    color: #111827;
  }

  .metric-label {
    font-size: 0.75rem;
    color: #6b7280;
  }

  .tides-box {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 0.85rem;
  }

  .tides-heading {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--azul-caribe, #0369a1);
    display: block;
    margin-bottom: 0.5rem;
  }

  .tides-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .tide-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
  }

  .tide-time {
    font-weight: 700;
    color: #111827;
  }

  .tide-type {
    color: #4b5563;
  }

  .recommendation-box {
    background: #f0fdf4;
    border-left: 3px solid var(--verde-territorio, #166534);
    padding: 0.75rem 1rem;
    border-radius: 0 8px 8px 0;
    font-size: 0.85rem;
    color: #374151;
  }

  .recommendation-box p {
    margin: 0.25rem 0 0;
    line-height: 1.4;
  }
</style>
