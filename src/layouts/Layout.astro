---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "COCOMANORTE",
  description = "Sitio institucional del Consejo Comunitario Mayor COCOMANORTE.",
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width" />

    <meta name="description" content={description} />

    <title>{title}</title>
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
